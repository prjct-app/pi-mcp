{
  "name": "@prjct.app/pi-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "A terminal-first MCP client for Pi. No automatic browsers or MCP App rendering.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-agent",
    "pi-coding-agent",
    "pi-extension",
    "ai-coding",
    "developer-tools",
    "mcp",
    "model-context-protocol",
    "terminal-first"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "docs",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "tsc --noEmit && npm run check:immutable",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts tests/*.test.mjs",
    "check:package": "npm pack --dry-run --ignore-scripts",
    "build": "rm -rf build && mkdir -p build && npm pack --ignore-scripts --pack-destination build >/dev/null && tar -xzf build/*.tgz -C build --strip-components=1 && rm -f build/*.tgz",
    "check:immutable": "! grep -rn '\\blet\\b' src/ || (echo 'Use immutable values: no let bindings in src/' && exit 1)",
    "build:pi": "node scripts/build-pi.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@napi-rs/keyring": "1.3.0",
    "zod": "^4.3.6",
    "@prjct.app/pi-tui-kit": "file:../pi-tui-kit",
    "@typesafe-ai/sdk": "0.6.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.20.0",
    "typebox": "1.3.3",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prjct-app/pi-mcp.git"
  },
  "homepage": "https://github.com/prjct-app/pi-mcp#readme",
  "bugs": {
    "url": "https://github.com/prjct-app/pi-mcp/issues"
  },
  "piBuild": {
    "external": [
      "@napi-rs/keyring"
    ]
  }
}
