{
  "name": "@prjct.app/pi-mcp",
  "version": "0.2.0",
  "description": "A terminal-first MCP client for Pi. No automatic browsers or MCP App rendering.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-agent",
    "pi-coding-agent",
    "pi-extension",
    "ai-coding",
    "developer-tools",
    "mcp",
    "model-context-protocol",
    "terminal-first"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/prjct-app/pi-mcp/main/docs/cover.png"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "docs",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "tsc --noEmit && npm run check:immutable",
    "test": "node --import ./tests/isolate.mjs --import tsx --test --test-concurrency=1 tests/*.test.ts tests/*.test.mjs",
    "check:package": "npm pack --dry-run --ignore-scripts",
    "build": "rm -rf build && mkdir -p build && npm pack --ignore-scripts --pack-destination build >/dev/null && tar -xzf build/*.tgz -C build --strip-components=1 && rm -f build/*.tgz",
    "check:immutable": "! grep -rn '\\blet\\b' src/ || (echo 'Use immutable values: no let bindings in src/' && exit 1)",
    "build:pi": "node scripts/build-pi.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@napi-rs/keyring": "1.3.0",
    "@prjct.app/pi-secrets": "^0.2.1",
    "@prjct.app/pi-tui-kit": "^0.3.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.20.0",
    "typebox": "1.3.7",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prjct-app/pi-mcp.git"
  },
  "homepage": "https://github.com/prjct-app/pi-mcp#readme",
  "bugs": {
    "url": "https://github.com/prjct-app/pi-mcp/issues"
  },
  "piBuild": {
    "external": [
      "@napi-rs/keyring",
      "@prjct.app/pi-secrets/privacy"
    ]
  },
  "overrides": {
    "minimatch": {
      "brace-expansion": "^5.0.12"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
